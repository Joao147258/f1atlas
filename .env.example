# F1Atlas — Arquivo Modelo de Variáveis de Ambiente
# Uso: Copie este arquivo para .env ou .env.local para desenvolvimento local.
# REGRA DE SEGURANÇA: NUNCA versione credenciais ou chaves secretas reais.

# Ambiente de Execução
NODE_ENV=development
PORT=3000

# Google Analytics 4 (Preparação inicial de telemetria pública)
# O Measurement ID é um identificador de fluxo público (ex.: G-XXXXXXXXXX), NÃO é uma chave secreta.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Placeholders para futuras integrações (não implementadas nesta etapa):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/f1atlas?schema=public
# F1_DATA_PROVIDER_URL=
# F1_DATA_PROVIDER_API_KEY=
